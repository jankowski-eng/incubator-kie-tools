{
  "$schema": "https://raw.githubusercontent.com/jetpack-io/devbox/0.10.4/.schema/devbox.schema.json",
  "packages": {
    "temurin-bin-17": "17.0.9",
    "nodejs": "24.12.0",
    "maven": "3.9.16",
    "glibcLocales": {
      "version": "2.40-66",
      "platforms": ["x86_64-linux", "aarch64-linux"]
    }
  },
  "env": {
    "PLAYWRIGHT_BROWSERS_PATH": "0",
    "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS": "true",
    "DEVBOX_COREPACK_ENABLED": "true",
    "PNPM_HOME": "$DEVBOX_PROJECT_ROOT/.devbox/pnpm-store",
    "PATH": "$DEVBOX_PROJECT_ROOT/.devbox/pnpm-store:$PATH"
  },
  "shell": {
    "init_hook": [],
    "scripts": {
      "versions": ["java --version && mvn -v && node -v && pnpm -v"]
    }
  }
}
